# LLM provider: watsonx | openai
PDR_LLM_PROVIDER=watsonx

# IBM watsonx (default — matches the original Connoisseur Companion stack)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
PDR_WATSONX_MODEL=ibm/granite-4-h-small

# OpenAI (optional alternative)
OPENAI_API_KEY=
PDR_OPENAI_MODEL=gpt-4o-mini

# Multimodal RAG
PDR_CHROMA_DIR=chroma_db
PDR_TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
PDR_CLIP_MODEL=openai/clip-vit-base-patch32
PDR_FUSION_TEXT_WEIGHT=0.55
PDR_FUSION_IMAGE_WEIGHT=0.30
PDR_FUSION_PREF_WEIGHT=0.15

# Personalization
PDR_DEFAULT_USER_ID=USER_FUSION_FINDER_99

# Gradio
PDR_GRADIO_SHARE=false
PDR_GRADIO_SERVER_NAME=127.0.0.1
PDR_GRADIO_SERVER_PORT=7860
